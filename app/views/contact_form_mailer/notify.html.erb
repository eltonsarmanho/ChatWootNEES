<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, sans-serif; color: #333; font-size: 15px; }
    .container { max-width: 600px; margin: 0 auto; padding: 24px; }
    .header { background: #2670e8; color: #fff; padding: 20px 24px; border-radius: 8px 8px 0 0; }
    .header h1 { margin: 0; font-size: 20px; }
    .body { background: #f9f9f9; padding: 24px; border-radius: 0 0 8px 8px; }
    .field { margin-bottom: 16px; }
    .label { font-size: 12px; font-weight: bold; text-transform: uppercase; color: #888; }
    .value { font-size: 15px; color: #222; margin-top: 4px; }
    .message-box { background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 16px; }
    .protocol { font-size: 13px; color: #888; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 12px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>📬 Nova mensagem do Formulário de Contato</h1>
    </div>
    <div class="body">
      <div class="field">
        <div class="label">Nome</div>
        <div class="value"><%= @nome %></div>
      </div>
      <div class="field">
        <div class="label">E-mail</div>
        <div class="value"><a href="mailto:<%= @email %>"><%= @email %></a></div>
      </div>
      <% if @telefone.present? %>
      <div class="field">
        <div class="label">Telefone</div>
        <div class="value"><%= @telefone %></div>
      </div>
      <% end %>
      <div class="field">
        <div class="label">Assunto</div>
        <div class="value"><%= @assunto %></div>
      </div>
      <div class="field">
        <div class="label">Mensagem</div>
        <div class="message-box"><%= simple_format(@mensagem) %></div>
      </div>
      <div class="protocol">Protocolo: <strong>#GP-<%= @protocolo %></strong></div>
    </div>
  </div>
</body>
</html>
